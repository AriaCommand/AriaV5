    protein: 45,
    carbs: 50,
    fat: 10,
    ingredients: 'Cabbage, eggs, flour, dashi, green onions, protein (pork belly/shrimp/squid), okonomiyaki sauce, Kewpie mayo, bonito flakes, aonori',
    notes: 'Dinner staple - Japanese savory pancake. Cabbage-heavy, filling, customizable protein.'
  },
  {
    name: 'Slow Cook Chicken Alfredo Pasta',
    calories: 560,
    protein: 65,
    carbs: 52,
    fat: 9,
    ingredients: 'Chicken, Alfredo sauce, pasta',
    notes: 'Slow cooked dinner - high protein, moderate carbs. Great for dinner.'
  },
  {
    name: 'Double Protein Shake (ISO100)',
    calories: 220,
    protein: 50,
    carbs: 4,
    fat: 1,
    ingredients: '2 scoops Dymatize ISO100 hydrolyzed protein powder, water',
    notes: 'Post-workout or afternoon protein boost. 2 scoops = 50g protein.'
  },
  {
    name: 'Turkey Burgers with Homemade Air Fryer French Fries',
    calories: 501,
    protein: 30,
    carbs: 54,
    fat: 17,
    ingredients: 'Ground turkey burger patties, burger buns, air fryer french fries, seasoning',
    notes: 'Dinner - turkey burger with homemade air fryer fries. Comfort meal, macro-friendly.'
  }
];

function loadRecipes() {
  const container = document.getElementById('recipes-list');
  const html = recipes.map(r => `
    <div class="recipe-card" onclick='alert("Log ${r.name}: ${r.calories} cal, ${r.protein}g protein, ${r.carbs}g carbs, ${r.fat}g fat - tell Aria to add this to your daily log!")'>
      <div class="recipe-name">${r.name}</div>
      <div class="recipe-macros">
        ${r.calories} cal · ${r.protein}g protein · ${r.carbs}g carbs · ${r.fat}g fat
      </div>
      <div style="color: #64748b; font-size: 0.75rem; margin-top: 4px;">
        <strong>Ingredients:</strong> ${r.ingredients || ''}
      </div>
      <div style="color: #64748b; font-size: 0.75rem; margin-top: 2px;">
        ${r.notes || ''}
      </div>
    </div>
  `).join('');
  container.innerHTML = html;
}

// Auto-load data when page loads
window.addEventListener('DOMContentLoaded', function() {
  loadData();
  loadRecipes();
});
</script>
</body>
</html>