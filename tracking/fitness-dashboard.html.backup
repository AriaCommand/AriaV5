<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kane's Fitness Tracker</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f172a;
    color: #e2e8f0;
    padding: 10px;
    line-height: 1.4;
    height: 100vh;
    overflow: hidden;
  }
  h1 { font-size: 1.2rem; margin-bottom: 0.3rem; color: #fbbf24; }
  .subtitle { color: #94a3b8; font-size: 0.8rem; margin-bottom: 10px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto 1fr;
    gap: 10px;
    height: calc(100vh - 70px);
  }
  .grid-log {
    grid-column: span 3;
    min-height: 0;
  }
  .card {
    background: #1e293b;
    border-radius: 8px;
    padding: 12px;
    border: 1px solid #334155;
    overflow: hidden;
  }
  .card h2 { font-size: 0.95rem; color: #fbbf24; margin-bottom: 8px; }
  .stat-row { display: flex; justify-content: space-between; margin-bottom: 4px; padding-bottom: 4px; border-bottom: 1px solid #334155; font-size: 0.85rem; }
  .stat-row:last-child { border-bottom: none; margin-bottom: 0; }
  .stat-label { color: #94a3b8; }
  .stat-value { font-weight: 600; color: #e2e8f0; }
  .stat-value.highlight { color: #4ade80; }
  .stat-value.warning { color: #fb923c; }
  .chart-container {
    width: 100%;
    min-height: 205px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0f172a;
    border-radius: 6px;
    padding: 4px;
  }
  .chart-container canvas {
    max-width: 100%;
    height: auto;
  }
  .macro-pie-container {
    width: 100%;
    min-height: 285px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 4px;
  }
  .macro-pie-container canvas {
    max-width: 100%;
    height: auto;
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  th, td { padding: 6px 6px; text-align: left; border-bottom: 1px solid #334155; }
  th { color: #fbbf24; font-weight: 600; }
  td { color: #e2e8f0; }
  td.macro { font-family: monospace; }
  .empty { color: #64748b; text-align: center; padding: 15px; font-size: 0.85rem; }
  .refresh {
    background: #fbbf24; color: #0f172a; border: none; padding: 6px 14px;
    border-radius: 6px; font-weight: 600; cursor: pointer; margin-bottom: 10px;
    font-size: 0.85rem;
  }
  .refresh:hover { background: #f59e0b; }
  .tabs { display: flex; gap: 8px; margin-bottom: 10px; }
  .tab-btn {
    background: #1e293b; color: #94a3b8; border: 1px solid #334155;
    padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 600;
  }
  .tab-btn:hover { background: #334155; color: #e2e8f0; }
  .tab-btn.active { background: #fbbf24; color: #0f172a; border-color: #fbbf24; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .recipe-card {
    background: #1e293b; border: 1px solid #334155; border-radius: 8px;
    padding: 12px; margin-bottom: 8px; cursor: pointer; transition: all 0.2s;
  }
  .recipe-card:hover { border-color: #fbbf24; background: #252f47; }
  .recipe-name { font-weight: 600; color: #fbbf24; font-size: 0.95rem; }
  .recipe-macros { color: #94a3b8; font-size: 0.8rem; margin-top: 4px; }
  .recipe-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 10px; overflow-y: auto; max-height: calc(100vh - 150px);
  }
  .date-header { color: #64748b; font-size: 0.7rem; text-transform: uppercase; }
  .log-scroll {
    max-height: 200px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #475569 #1e293b;
  }
  .log-scroll::-webkit-scrollbar { width: 6px; }
  .log-scroll::-webkit-scrollbar-track { background: #1e293b; }
  .log-scroll::-webkit-scrollbar-thumb { background: #475569; border-radius: 3px; }
</style>
</head>
<body>
<h1>💪 Kane's Fitness Tracker</h1>
<div class="subtitle">Data is stored locally in fitness-data.json</div>

<button class="refresh" onclick="loadData()">↻ Refresh Data</button>

<div class="tabs">
  <button class="tab-btn active" onclick="showTab('dashboard')" id="tab-dashboard">Dashboard</button>
  <button class="tab-btn" onclick="showTab('log')" id="tab-log">Daily Log</button>
  <button class="tab-btn" onclick="showTab('workout')" id="tab-workout">Workout Log</button>
  <button class="tab-btn" onclick="showTab('recipes')" id="tab-recipes">Recipes</button>
</div>

<div id="dashboard-tab" class="tab-content active">
<div class="grid">
  <div class="card">
    <h2>📊 Latest Stats</h2>
    <div id="latest-stats">
      <div class="empty">No data yet</div>
    </div>
  </div>

  <div class="card">
    <h2>🎯 Goals & Progress</h2>
    <div id="goals-stats">
      <div class="stat-row">
        <span class="stat-label">Goal Weight</span>
        <span class="stat-value" id="goal-weight">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Current Weight</span>
        <span class="stat-value" id="current-weight">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Pounds to Lose</span>
        <span class="stat-value warning" id="pounds-to-lose">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Goal Body Fat</span>
        <span class="stat-value" id="goal-bf">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Current Body Fat</span>
        <span class="stat-value" id="current-bf">--</span>
      </div>
    <div class="stat-row">
        <span class="stat-label">Water Target</span>
        <span class="stat-value" id="water-target">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Water Today</span>
        <span class="stat-value" id="water-today">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Est. Weeks to Goal</span>
        <span class="stat-value highlight" id="weeks-to-goal">--</span>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>🎯 TDEE & Targets</h2>
    <div id="tdee-stats">
      <div class="stat-row">
        <span class="stat-label">Current Weight</span>
        <span class="stat-value" id="tdee-weight">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Body Fat %</span>
        <span class="stat-value" id="tdee-bf">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Lean Body Mass</span>
        <span class="stat-value" id="tdee-lbm">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">BMR (Katch-McArdle)</span>
        <span class="stat-value" id="tdee-bmr">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Activity Multiplier</span>
        <span class="stat-value" id="tdee-multiplier">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">TDEE (Maintenance)</span>
        <span class="stat-value highlight" id="tdee-tdee">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Target Deficit</span>
        <span class="stat-value warning" id="tdee-deficit">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Daily Target Calories</span>
        <span class="stat-value highlight" id="tdee-target">--</span>
      </div>
      <div class="stat-row" style="margin-top:10px; border-top: 2px solid #334155; padding-top: 10px;">
        <span class="stat-label">Protein Target</span>
        <span class="stat-value" id="macro-protein">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Carb Target</span>
        <span class="stat-value" id="macro-carbs">--</span>
      </div>
      <div class="stat-row">
        <span class="stat-label">Fat Target</span>
        <span class="stat-value" id="macro-fat">--</span>
      </div>
    </div>
  </div>

  <div class="card" style="grid-column: span 3;">
    <h2>📈 Trends</h2>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; justify-items: center;">
      <div style="max-width: 100%; width: 100%;">
        <h3 style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 8px; text-align: center;">Last 7 Days - Calories Burned</h3>
        <div id="workout-bar-chart" class="chart-container"></div>
      </div>
      <div style="max-width: 100%; width: 100%;">
        <h3 style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 8px; text-align: center;">Today's Macros</h3>
        <div id="macro-pie-chart" class="macro-pie-container"></div>
      </div>
    </div>
  </div>
</div>
</div>

<div id="log-tab" class="tab-content">
  <div class="card" style="margin-top: 10px;">
    <h2>📝 Daily Log</h2>
    <div class="log-scroll" id="daily-log" style="max-height: calc(100vh - 180px); overflow-y: auto;">
      <div class="empty">No data yet</div>
    </div>
  </div>
</div>

<div id="workout-tab" class="tab-content">
  <div class="card" style="margin-top: 10px;">
    <h2>💪 Daily Workout Log</h2>
    <div class="log-scroll" id="workout-log" style="max-height: calc(100vh - 180px); overflow-y: auto;">
      <div class="empty">No workout data yet</div>
    </div>
  </div>
</div>

<div id="recipes-tab" class="tab-content">
  <h2 style="color: #fbbf24; margin-bottom: 10px;">🍳 Recipes</h2>
  <div class="recipe-grid" id="recipes-list">
    <!-- Recipes loaded by JS -->
  </div>
</div>

