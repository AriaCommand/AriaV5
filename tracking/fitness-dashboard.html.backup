};
let data = [];
let userProfile = {};
let settings = {};
let tdeeHistory = [];

function loadData() {
  // Try to fetch fresh data from fitness-data.json first
  fetch('fitness-data.json?t=' + Date.now(), { cache: 'no-store' })
    .then(response => {
      if (!response.ok) throw new Error('Network response was not ok');
      return response.json();
    })
    .then(freshData => {
      data = freshData.entries || [];
      userProfile = freshData.userProfile || {};
      settings = freshData.settings || {};
      tdeeHistory = freshData.tdeeHistory || [];
      render();
    })
    .catch(error => {
      console.warn('Could not fetch fitness-data.json, falling back to embedded data:', error);
      // Use embedded fitness data as fallback
      try {
        data = fitnessData.entries || [];
        userProfile = fitnessData.userProfile || {};
        settings = fitnessData.settings || {};
        tdeeHistory = fitnessData.tdeeHistory || [];
        render();
      } catch (fallbackError) {
        console.error('Error loading embedded data:', fallbackError);
        document.getElementById('latest-stats').innerHTML = '<div class="empty">Error loading data.</div>';
      }
    });
}

function calculateTDEE(weight, bfPercent, activityLevel) {
  // Katch-McArdle formula
  const weightKg = weight * 0.453592;
  const leanMassKg = weightKg * (1 - bfPercent / 100);
  const bmr = 370 + (21.6 * leanMassKg);

  const multipliers = {
    'sedentary': 1.2,
    'light': 1.375,
    'moderate': 1.55,
    'active': 1.725,
    'very active': 1.9
  };

  const multiplier = multipliers[activityLevel] || 1.55;
  const tdee = Math.round(bmr * multiplier);

  return {
    bmr: Math.round(bmr),
    tdee: tdee,
    leanMassKg: Math.round(leanMassKg * 10) / 10,
    multiplier: multiplier
  };
}

function calculateMacros(calories, weight, bfPercent) {
  // Higher protein for cutting, especially at higher body fat
  const leanMass = weight * (1 - bfPercent / 100);
  const protein = Math.round(leanMass * 1.1); // 1.1g per lb of lean mass
  const fat = Math.round(calories * 0.30 / 9); // 30% of calories from fat
  const carbs = Math.round((calories - (protein * 4) - (fat * 9)) / 4);

  return { protein, carbs, fat };
}

function render() {
  if (!data || data.length === 0) {
    return;
  }

  // Sort by date ascending so latest is always correct
  data.sort((a, b) => new Date(a.date) - new Date(b.date));

  const latest = data[data.length - 1];
  const weight = latest.weight || userProfile.currentWeight || 164;
  const bfPercent = latest.bfPercent || userProfile.bodyFatPercent || 29;
  const activityLevel = userProfile.activityLevel || 'moderate';

  // Calculate TDEE
  const tdeeData = calculateTDEE(weight, bfPercent, activityLevel);
  const deficit = 500; // Moderate deficit
  const targetCalories = tdeeData.tdee - deficit;

  // Calculate macros
  const macros = calculateMacros(targetCalories, weight, bfPercent);

  // Calculate workout calories and net calories for Latest Stats
  const workoutCaloriesBurned = latest.workout && latest.workout.type === 'workout' && Array.isArray(latest.workout.activities)
    ? latest.workout.activities.reduce((sum, a) => sum + (a.caloriesBurned || 0), 0)
    : null;
  const calorieValue = Number(latest.calories);
  const hasCalories = latest.calories !== undefined && latest.calories !== null && latest.calories !== '' && Number.isFinite(calorieValue);
  const netCalories = hasCalories && workoutCaloriesBurned !== null ? calorieValue - workoutCaloriesBurned : null;
  const netCaloriesDisplay = netCalories !== null ? netCalories : '--';
  const netCaloriesStyle = typeof netCalories === 'number' && netCalories < 1500 ? ' style="color: #ef4444;"' : '';

  // Latest stats
  document.getElementById('latest-stats').innerHTML = `
    <div class="stat-row">
      <span class="stat-label">Weight</span>
      <span class="stat-value">${latest.weight || '--'} lbs</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Calories</span>
      <span class="stat-value">${latest.calories || '--'} kcal</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Calories Burned</span>
      <span class="stat-value" style="color: #fb923c;">${workoutCaloriesBurned !== null ? workoutCaloriesBurned : '--'} kcal</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Net Calories</span>
      <span class="stat-value"${netCaloriesStyle}>${netCaloriesDisplay} kcal</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Protein</span>
      <span class="stat-value highlight">${latest.protein || '--'}g</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Carbs</span>
      <span class="stat-value">${latest.carbs || '--'}g</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Water</span>
      <span class="stat-value">${latest.waterOz || 0} / ${settings.waterTarget || 83.9} oz</span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Fat</span>
      <span class="stat-value">${latest.fat || '--'}g</span>
    </div>
  `;

  // Goals & Progress
  const goalWeight = userProfile.goalWeight || 150;
  const goalBF = userProfile.goalBodyFatPercent || 10;
  const currentWeight = latest.weight || userProfile.currentWeight || 164;
  const currentBF = latest.bfPercent || userProfile.bodyFatPercent || 29;
  const poundsToLose = currentWeight - goalWeight;
  const weeksToGoal = Math.round(poundsToLose / 1); // ~1 lb/week at 500 cal deficit

  document.getElementById('goal-weight').textContent = goalWeight + ' lbs';
  document.getElementById('current-weight').textContent = currentWeight + ' lbs';
  document.getElementById('pounds-to-lose').textContent = poundsToLose + ' lbs';
  document.getElementById('goal-bf').textContent = goalBF + '%';
  document.getElementById('current-bf').textContent = currentBF + '%';
  document.getElementById('water-target').textContent = (settings.waterTarget || 83.9) + ' oz';
  document.getElementById('water-today').textContent = (latest.waterOz || 0) + ' oz';
  document.getElementById('weeks-to-goal').textContent = weeksToGoal + ' weeks';

  // TDEE Stats
  document.getElementById('tdee-weight').textContent = weight + ' lbs';
  document.getElementById('tdee-bf').textContent = bfPercent + '%';
  document.getElementById('tdee-lbm').textContent = tdeeData.leanMassKg + ' kg';
  document.getElementById('tdee-bmr').textContent = tdeeData.bmr + ' kcal';
  document.getElementById('tdee-multiplier').textContent = tdeeData.multiplier + 'x (' + activityLevel + ')';
  document.getElementById('tdee-tdee').textContent = tdeeData.tdee + ' kcal';
  document.getElementById('tdee-deficit').textContent = '-' + deficit + ' kcal';
  document.getElementById('tdee-target').textContent = targetCalories + ' kcal';
  document.getElementById('macro-protein').textContent = macros.protein + 'g';
  document.getElementById('macro-carbs').textContent = macros.carbs + 'g';
  document.getElementById('macro-fat').textContent = macros.fat + 'g';

  // Today's macro pie chart
  const macroCanvas = document.createElement('canvas');
  macroCanvas.width = 560;
  macroCanvas.height = 280;
  document.getElementById('macro-pie-chart').innerHTML = '';
  document.getElementById('macro-pie-chart').appendChild(macroCanvas);
  drawPieChart(macroCanvas, latest.protein, latest.carbs, latest.fat);

  // Workout bar chart (last 7 days)
  const barCanvas = document.createElement('canvas');
  barCanvas.width = 600;
  barCanvas.height = 200;
  document.getElementById('workout-bar-chart').innerHTML = '';
  document.getElementById('workout-bar-chart').appendChild(barCanvas);
  drawBarChart(barCanvas, data);

  // Daily log table
  const rows = data.slice(-14).reverse().map(entry => `
    <tr>
      <td>${entry.date}</td>
      <td>${entry.weight || '--'}</td>
      <td class="macro">${entry.calories || '--'}</td>
      <td class="macro">${entry.protein || '--'}</td>
      <td class="macro">${entry.carbs || '--'}</td>
      <td class="macro">${entry.fat || '--'}</td>
      <td class="macro">${entry.waterOz || 0}oz</td>
    </tr>
  `).join('');

  document.getElementById('daily-log').innerHTML = `
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Weight</th>
          <th>Calories</th>
          <th>Protein</th>
          <th>Carbs</th>
          <th>Fat</th>
          <th>Water</th>
        </tr>
      </thead>
      <tbody>${rows}</tbody>
    </table>
  `;

  // Workout log table
  const workoutRows = data.slice(-14).reverse().map(entry => {
    const workout = entry.workout;

    if (!workout) {
      return `
        <tr>
          <td>${entry.date}</td>
          <td>--</td>
          <td>--</td>
          <td class="macro">--</td>
          <td class="macro">--</td>
          <td>--</td>
        </tr>
      `;
    }

    const isRestDay = workout.type === 'rest';
    const activities = workout.activities || [];
    const activityNames = activities.length
      ? activities.map(activity => activity.name).join('<br>')
      : (isRestDay ? '--' : '--');
    const durations = activities
      .map(activity => activity.duration)
      .filter(Boolean)
      .join('<br>') || '--';
    const caloriesBurned = activities
      .map(activity => activity.caloriesBurned)
      .filter(calories => calories !== undefined && calories !== null)
      .join('<br>') || '--';
    const activityNotes = activities
      .map(activity => activity.notes)
      .filter(Boolean);
    const notes = [...new Set([workout.notes, ...activityNotes].filter(Boolean))]
      .join('<br>') || '--';

    return `
      <tr>
        <td>${entry.date}</td>
        <td>${isRestDay ? 'Rest Day' : 'Workout'}</td>
        <td>${activityNames}</td>
        <td class="macro">${durations}</td>
        <td class="macro">${caloriesBurned}</td>
        <td>${notes}</td>
      </tr>
    `;
  }).join('');

  document.getElementById('workout-log').innerHTML = workoutRows ? `
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Type</th>
          <th>Activities</th>
          <th>Duration</th>
          <th>Calories</th>
          <th>Notes</th>
        </tr>
      </thead>
      <tbody>${workoutRows}</tbody>
    </table>
  ` : '<div class="empty">No workout data yet</div>';
}

function drawChart(canvas, data, key, color) {
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  const padding = 30;

  ctx.clearRect(0, 0, w, h);

  if (data.length < 2) return;

  const values = data.map(d => d[key]).filter(v => v !== undefined && v !== null);
  if (values.length < 2) return;

  const min = Math.min(...values) * 0.98;
  const max = Math.max(...values) * 1.02;
  const range = max - min || 1;

  // Draw grid
  ctx.strokeStyle = '#334155';
  ctx.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = padding + (h - 2 * padding) * i / 4;
    ctx.beginPath();
    ctx.moveTo(padding, y);
    ctx.lineTo(w - padding, y);
    ctx.stroke();
  }

  // Draw line
  ctx.strokeStyle = color;
  ctx.lineWidth = 2;
  ctx.beginPath();

  values.forEach((val, i) => {
    const x = padding + (w - 2 * padding) * i / (values.length - 1);
    const y = h - padding - (h - 2 * padding) * (val - min) / range;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  });
  ctx.stroke();

  // Draw points
  ctx.fillStyle = color;
  values.forEach((val, i) => {
    const x = padding + (w - 2 * padding) * i / (values.length - 1);
    const y = h - padding - (h - 2 * padding) * (val - min) / range;
    ctx.beginPath();
    ctx.arc(x, y, 3, 0, Math.PI * 2);
    ctx.fill();
  });
}

function drawBarChart(canvas, data) {
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  const padding = 40;
  const chartW = w - padding * 2;
  const chartH = h - padding * 2;

  // Get last 7 days of workout data
  const last7 = data.slice(-7);
  const labels = last7.map(d => d.date.slice(5)); // MM-DD format
  const values = last7.map(d => {
    if (d.workout && d.workout.type === 'workout' && Array.isArray(d.workout.activities)) {
      return d.workout.activities.reduce((sum, a) => sum + (a.caloriesBurned || 0), 0);
    }
    return 0; // rest day or no data = 0
  });

  const maxVal = Math.max(...values, 1);
  const barWidth = chartW / values.length * 0.6;
  const barSpacing = chartW / values.length;

  ctx.clearRect(0, 0, w, h);
  ctx.fillStyle = '#0f172a';
  ctx.fillRect(0, 0, w, h);

  // Draw grid line
  ctx.strokeStyle = '#334155';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(padding, padding);
  ctx.lineTo(w - padding, padding);
  ctx.stroke();

  // Draw bars
  values.forEach((val, i) => {
    const x = padding + i * barSpacing + (barSpacing - barWidth) / 2;
    const barH = (val / maxVal) * chartH;
    const visibleBarH = val > 0 ? barH : 4;
    const y = h - padding - visibleBarH;

    // Bar color: orange if workout, gray if rest
    ctx.fillStyle = val > 0 ? '#fb923c' : '#334155';
    ctx.fillRect(x, y, barWidth, visibleBarH);

    // Value label on top
    ctx.fillStyle = '#e2e8f0';
    ctx.font = '12px -apple-system, BlinkMacSystemFont, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(val, x + barWidth / 2, y - 5);

    // Date label below
    ctx.fillStyle = '#94a3b8';
    ctx.font = '10px -apple-system, BlinkMacSystemFont, sans-serif';
    ctx.fillText(labels[i], x + barWidth / 2, h - padding + 15);
  });
}

function drawPieChart(canvas, protein, carbs, fat) {
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  const centerX = 155;
  const centerY = 145;
  const radius = 98;
  const macros = [
    { label: 'Protein', value: Number(protein) || 0, color: '#4ade80' },
    { label: 'Carbs', value: Number(carbs) || 0, color: '#fbbf24' },
    { label: 'Fat', value: Number(fat) || 0, color: '#fb923c' }
  ];
  const total = macros.reduce((sum, macro) => sum + macro.value, 0);

  ctx.clearRect(0, 0, w, h);
  ctx.font = '600 14px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  if (total <= 0) {
    ctx.fillStyle = '#94a3b8';
    ctx.fillText('No macro data', w / 2, h / 2);
    return;
  }

  let startAngle = -Math.PI / 2;
  macros.forEach(macro => {
    const sliceAngle = (macro.value / total) * Math.PI * 2;
    const endAngle = startAngle + sliceAngle;

    ctx.beginPath();
    ctx.moveTo(centerX, centerY);
    ctx.arc(centerX, centerY, radius, startAngle, endAngle);
    ctx.closePath();
    ctx.fillStyle = macro.color;
    ctx.fill();
    ctx.strokeStyle = '#1e293b';
    ctx.lineWidth = 3;
    ctx.stroke();

    if (macro.value > 0 && sliceAngle > 0.35) {
      const labelAngle = startAngle + sliceAngle / 2;
      const labelX = centerX + Math.cos(labelAngle) * (radius * 0.58);
      const labelY = centerY + Math.sin(labelAngle) * (radius * 0.58);
      ctx.fillStyle = '#0f172a';
      ctx.font = '700 14px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      ctx.fillText(`${Math.round((macro.value / total) * 100)}%`, labelX, labelY);
    }

    startAngle = endAngle;
  });

  // Center total
  ctx.beginPath();
  ctx.arc(centerX, centerY, 42, 0, Math.PI * 2);
  ctx.fillStyle = '#0f172a';
  ctx.fill();
  ctx.strokeStyle = '#334155';
  ctx.lineWidth = 1;
  ctx.stroke();
  ctx.fillStyle = '#e2e8f0';
  ctx.font = '700 18px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
  ctx.fillText(`${total}g`, centerX, centerY - 5);
  ctx.fillStyle = '#94a3b8';
  ctx.font = '600 12px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
  ctx.fillText('total', centerX, centerY + 13);

  // Legend with grams and percentages
  const legendX = 330;
  const legendStartY = 91;
  ctx.textAlign = 'left';
  ctx.textBaseline = 'middle';
  macros.forEach((macro, i) => {
    const y = legendStartY + i * 54;
    const percent = Math.round((macro.value / total) * 100);

    ctx.fillStyle = macro.color;
    ctx.fillRect(legendX, y - 9, 18, 18);

    ctx.fillStyle = '#e2e8f0';
    ctx.font = '700 15px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText(macro.label, legendX + 28, y - 5);
    ctx.fillStyle = '#94a3b8';
    ctx.font = '13px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
    ctx.fillText(`${macro.value}g • ${percent}%`, legendX + 28, y + 13);
  });
}

// Load on start
loadData();

// Tab switching
function showTab(tabName) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
  document.getElementById(tabName + '-tab').classList.add('active');
  document.getElementById('tab-' + tabName).classList.add('active');
  if (tabName === 'recipes') loadRecipes();
}

